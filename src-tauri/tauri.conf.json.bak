{
  "version": "2.7.1",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "longDescription": "望仔",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources"],
    "publisher": "望仔",
    "externalBin": ["sidecar/verge-mihomo", "sidecar/verge-mihomo-alpha"],
    "copyright": "GNU General Public License v3.0 · Based on Clash Verge Rev, modified by 望仔",
    "category": "DeveloperTool",
    "shortDescription": "望仔",
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run web:dev",
    "devUrl": "http://localhost:3000/",
    "removeUnusedCommands": true
  },
  "productName": "望仔",
  "identifier": "io.github.wlxlyxa.wangzai",
 "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZENDBEODM3RTMxMzhENzYKUldSMmpSUGpOOWhBL2JjR3JENXZHK3BuMFZPcFViZUhha1Y1V0Vnb25vUUhqeGNkamNwSUMrQk0K",
      "endpoints": [
        "https://gh-proxy.org/https://github.com/wlxlyxa/wangzai/releases/download/updater/update.json",
        "https://ghfast.top/https://github.com/wlxlyxa/wangzai/releases/download/updater/update.json",
        "https://github.com/wlxlyxa/wangzai/releases/download/updater/update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["wangzai"]
      }
    }
  },
  "app": {
    "security": {
      "capabilities": ["desktop-capability", "migrated"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  }
}